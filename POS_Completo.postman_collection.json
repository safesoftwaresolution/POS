    {
      "name": "08. 🏛️ Facturación — Super Admin configura el local",
      "description": "Solo SUPER_ADMIN. Usa el token de superadmin_token.\n\nFlujo: Ver locales → Aprobar solicitud → Cargar credenciales Factus → Cambiar entorno → Probar conexión.",
      "item": [
        {
          "name": "Listar Locales por Etapa de Habilitación",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superadmin_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/backoffice/billing?status=DOCUMENTS_SUBMITTED", "host": ["{{baseUrl}}"], "path": ["api","v1","backoffice","billing"], "query": [{"key":"status","value":"DOCUMENTS_SUBMITTED","description":"NOT_REQUESTED | DOCUMENTS_SUBMITTED | UNDER_REVIEW | ACTIVE | REJECTED | SUSPENDED"}] },
            "description": "Filtra locales por etapa del proceso. Valores posibles: NOT_REQUESTED, DOCUMENTS_SUBMITTED, UNDER_REVIEW, ACTIVE, REJECTED, SUSPENDED."
          }
        },
        {
          "name": "Consultar Estado de Facturación del Local",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superadmin_token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/backoffice/stores/{{store_id}}/billing", "host": ["{{baseUrl}}"], "path": ["api","v1","backoffice","stores","{{store_id}}","billing"] },
            "description": "Muestra el estado del local, si cada entorno tiene credenciales configuradas y qué rango de numeración eligió el administrador."
          }
        },
        {
          "name": "Cargar Credenciales Factus — SANDBOX",
