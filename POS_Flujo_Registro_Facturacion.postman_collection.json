    {
      "name": "05. 📄 Rangos de Numeración DIAN & Factus",
      "description": "Gestión de las resoluciones de facturación electrónica y consecutivos autorizados.",
      "item": [
        {
          "name": "09. Consultar Rangos de Numeración DIAN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var ranges = pm.response.json();",
                  "console.log('🏛️ Rangos autorizados por la DIAN consultados:', ranges.length);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/billing/numbering-ranges/dian",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "numbering-ranges",
                "dian"
              ]
            },
            "description": "Consulta en tiempo real ante la DIAN las resoluciones y rangos autorizados asociados al software."
          }
        },
        {
          "name": "10. Listar Rangos de Numeración en Factus",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var ranges = pm.response.json();",
                  "if (Array.isArray(ranges) && ranges.length > 0) {",
                  "    var setpRange = ranges.find(function(r) { return r.id === 389 || r.prefix === 'SETP'; });",
                  "    var sel = setpRange ? setpRange : ranges[0];",
                  "    pm.collectionVariables.set('range_id', String(sel.id));",
                  "    pm.environment.set('range_id', String(sel.id));",
                  "    console.log('📋 Rango Factus V2 detectado:', sel.id, '| Prefijo:', sel.prefix, '| Resolución:', sel.resolutionNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/billing/numbering-ranges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "numbering-ranges"
              ]
            },
            "description": "Lista los rangos de numeración registrados y activos en Factus V2."
          }
        },
        {
          "name": "10b. Consultar Detalle de Resolución por ID (Factus V2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var range = pm.response.json();",
                  "console.log('🏛️ Detalle de Resolución consultado:');",
                  "console.log('   - ID Factus:', range.id);",
                  "console.log('   - Prefijo:', range.prefix);",
                  "console.log('   - Número de Resolución:', range.resolutionNumber);",
                  "console.log('   - Consecutivo actual:', range.current);",
                  "console.log('   - Rango autorizado: Desde', range.from, 'hasta', range.to);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/billing/numbering-ranges/{{range_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "numbering-ranges",
                "{{range_id}}"
              ]
            },
            "description": "Consulta en Factus V2 los datos legales completos del rango de numeración seleccionado por ID."
          }
        },
        {
          "name": "11. Registrar / Habilitar Rango de Numeración en Factus",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created o 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);",
                  "});",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data && data.id) {",
                  "        pm.collectionVariables.set('range_id', String(data.id));",
                  "        pm.environment.set('range_id', String(data.id));",
                  "        console.log('✅ Rango de numeración activo con ID:', data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"01\",\n  \"prefix\": \"SETP\",\n  \"resolution_number\": \"18760000001\",\n  \"current\": 990017598,\n  \"start_date\": \"2019-01-19\",\n  \"end_date\": \"2030-01-19\",\n  \"from\": 990000000,\n  \"to\": 995000000,\n  \"technical_key\": \"fc8eac422eba16e22ffd8c6f94b3f40a6e38162c\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/billing/numbering-ranges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "numbering-ranges"
              ]
            },
            "description": "Registra una resolución de numeración DIAN en Factus para habilitar la emisión electrónica."
          }
        },
        {
          "name": "11b. ✅ Usar Rango para Facturar (set-default) — Flujo Normal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var range = pm.response.json();",
                  "pm.test(\"Devuelve el rango elegido con su ID\", function () {",
                  "    pm.expect(range.id).to.be.a('number');",
                  "});",
                  "pm.test(\"El rango está activo\", function () {",
                  "    pm.expect(range.isActive).to.be.true;",
                  "});",
                  "console.log('🎯 Rango predeterminado configurado:', range.id, '| Prefijo:', range.prefix, '| Resolución:', range.resolutionNumber);",
                  "console.log('✅ Las próximas facturas del local usarán este rango.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/billing/numbering-ranges/{{range_id}}/set-default",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "billing", "numbering-ranges", "{{range_id}}", "set-default"]
            },
            "description": "Elige el rango con el que el local facturará en su entorno activo (sandbox o producción). Solo ADMINISTRATOR puede hacerlo. Devuelve el rango elegido. \n\n**Prerrequisito:** El rango `{{range_id}}` debe existir en la cuenta Factus del local y estar activo.\n\n**Respuestas posibles:**\n- `200 OK` — rango configurado exitosamente.\n- `404 Not Found` — el rango no existe en la cuenta del local.\n- `409 Conflict` — el rango está inactivo o la resolución venció.\n- `403 Forbidden` — el rol no es ADMINISTRATOR."
          }
        },
        {
          "name": "11c. ❌ set-default con Rango Inexistente (debe dar 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "console.log('✅ Correcto: el rango 999999 no existe, el backend lo rechazó con 404.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/billing/numbering-ranges/999999/set-default",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "billing", "numbering-ranges", "999999", "set-default"]
            },
            "description": "Prueba de error: intenta elegir un rango que no existe en Factus. El backend debe responder 404."
          }
        },
        {
          "name": "11d. ❌ set-default con Rango Inactivo (debe dar 409)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Pasos manuales previos:",
                  "// 1. Desactiva el rango con: PATCH /api/v1/billing/numbering-ranges/{{range_id}}/toggle-status",
                  "//    (primero configura otro rango como set-default para poder desactivar este).",
                  "// 2. Luego ejecuta esta petición."
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 409 Conflict (inactivo) o 200 si sigue activo\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 409]);",
                  "});",
                  "if (pm.response.code === 409) {",
                  "    var body = pm.response.json();",
                  "    console.log('✅ Correcto: el rango inactivo fue rechazado con 409. Mensaje:', body.message);",
                  "} else {",
                  "    console.log('ℹ️ El rango sigue activo, no se pudo probar el caso de error. Desactívalo primero con toggle-status.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/billing/numbering-ranges/{{range_id}}/set-default",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "billing", "numbering-ranges", "{{range_id}}", "set-default"]
            },
            "description": "Prueba de error: intenta elegir un rango inactivo. El backend debe responder 409 Conflict con mensaje 'está inactivo'.\n\n**Pasos previos manuales:**\n1. Ejecuta `PATCH /toggle-status` en el rango para desactivarlo (primero asegúrate de que otro rango está como predeterminado).\n2. Ejecuta esta petición."
          }
        },
        {
          "name": "11e. 👁️ Verificar Rango Activo Guardado (Super Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"sandboxNumberingRangeId está configurado\", function () {",
                  "    pm.expect(data.sandboxNumberingRangeId).to.not.be.null;",
                  "});",
                  "console.log('👁️ Estado visible al Super Admin:');",
                  "console.log('   sandboxNumberingRangeId  :', data.sandboxNumberingRangeId);",
                  "console.log('   productionNumberingRangeId:', data.productionNumberingRangeId);",
                  "console.log('   Entorno activo            :', data.environment);",
                  "console.log('   Estado facturación        :', data.status);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/backoffice/stores/{{store_id}}/billing",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "backoffice", "stores", "{{store_id}}", "billing"]
            },
            "description": "Confirma desde el back-office (Super Admin) que el campo `sandboxNumberingRangeId` quedó actualizado con el rango elegido por el administrador del local. \n\n**Nota:** Para usar este endpoint el token debe ser de un SUPER_ADMIN. Si estás usando el token del Administrador, recibirás 403."
          }
        }
      ]
    },
    {
      "name": "06. 💰 Venta & Emisión de Factura",
      "description": "Registro de la transacción de venta, descuento de inventario y facturación electrónica.",
      "item": [
        {
          "name": "12. Registrar Venta & Emitir Factura Electrónica",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Venta creada con ID e invoiceNumber\", function () {",
                  "    pm.expect(data.id).to.be.a('number');",
                  "    pm.expect(data.invoiceNumber).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('sale_id', String(data.id));",
                  "pm.environment.set('sale_id', String(data.id));",
                  "console.log('🎉 VENTA REGISTRADA EXITOSAMENTE!');",
                  "console.log('🏷️ ID Venta:', data.id);",
                  "console.log('📑 Consecutivo:', data.invoiceNumber);",
                  "console.log('💵 Total:', data.totalAmount, '| Cambio:', data.cashChange);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Clave única para garantizar idempotencia y evitar ventas duplicadas"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customer_id}},\n  \"cashReceived\": 50000.00,\n  \"sendToFactus\": true,\n  \"paymentMethod\": \"CASH\",\n  \"items\": [\n    {\n      \"productId\": {{product_id}},\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sales"
              ]
            },
            "description": "Registra la venta:\n1. Valida y descuenta stock automáticamente en inventario.\n2. Genera número de factura consecutivo.\n3. Dispara la emisión de la Factura Electrónica a Factus/DIAN (si sendToFactus es true).\n4. Guarda el ID de la venta en {{sale_id}}."
          }
        },
        {
