  ],
  "item": [
    {
      "name": "01. 👤 Registro & Autenticación (Dueño)",
      "description": "Auto-registro público del futuro dueño y login para obtener el JWT.",
      "item": [
        {
          "name": "01. Auto-registro de Administrador (Opcional si usas admin existente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "});",
                  "console.log('✅ Usuario registrado. Si está configurado log email, revisa la consola del backend para el enlace de verificación.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Carlos Martínez\",\n  \"username\": \"carlos_dueno_{{$randomInt}}\",\n  \"email\": \"dueno_{{$randomInt}}@comercio.com\",\n  \"password\": \"ClaveSegura123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Crea una nueva cuenta con rol ADMINISTRATOR. Queda pendiente de verificación de correo si está habilitada."
          }
        },
        {
          "name": "02. Login Administrador (Captura JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "pm.test(\"Token JWT recibido\", function () {",
                  "    pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('bearer_token', data.token);",
                  "    pm.environment.set('bearer_token', data.token);",
                  "    console.log('🔑 Bearer Token guardado:', data.token.substring(0, 20) + '...');",
                  "}",
                  "if (data.storeId) {",
                  "    pm.collectionVariables.set('store_id', String(data.storeId));",
                  "    pm.environment.set('store_id', String(data.storeId));",
                  "    console.log('🏪 Store ID ya asignado:', data.storeId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión con la cuenta de Administrador. Guarda automáticamente el JWT en {{bearer_token}} para todas las peticiones siguientes."
          }
        }
      ]
    },
