# ==============================================================================
# Archivo de Ejemplo de Variables de Entorno (.env.example) - Backend
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo como '.env':
#    cp .env.example .env
# 2. Reemplaza los valores de ejemplo con tus credenciales y secretos locales.
# 3. NUNCA subas el archivo '.env' al repositorio Git (ya está en .gitignore).
# ==============================================================================

# Perfil Activo y Base de Datos (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/app_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tu_password_local_aqui

# Variables para Docker Compose
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=tu_password_postgres_aqui

# Seguridad y Autenticación JWT
# Genera una clave segura de al menos 256 bits (64 caracteres hexadecimales)
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_256_bits_aqui
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_REFRESH_REUSE_GRACE_MS=15000
JWT_COOKIE_SECURE=false

# Integración Facturación Electrónica (Factus)
# Las credenciales de Factus de cada local se cargan desde el sistema (super admin) y viven
# cifradas en la base de datos. Esta clave es la que las cifra: genérala con `openssl rand -base64 32`
# y NO la pierdas ni la cambies (los secretos guardados dejarían de poder leerse).
BILLING_ENCRYPTION_KEY=genera_una_clave_base64_de_32_bytes_aqui
BILLING_PROVIDER=factus
# URLs de Factus por entorno (opcionales; estos son los valores por defecto). Las credenciales y el
# rango de numeración NO van aquí: el super admin los carga por local desde el sistema.
FACTUS_URL_SANDBOX=https://api-sandbox.factus.com.co
FACTUS_URL_PRODUCTION=https://api.factus.com.co


# ------------------------------------------------------------------------------
# Cloudflare R2 / Almacenamiento de Imágenes y Archivos
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=tu_cloudflare_account_id_aqui
R2_ACCESS_KEY_ID=tu_r2_access_key_id_aqui
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key_aqui
R2_BUCKET_NAME=app-pos-bucket
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev