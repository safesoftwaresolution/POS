# ==============================================================================
# Archivo de Ejemplo de Variables de Entorno (.env.example) - Backend
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo como '.env':
#    cp .env.example .env
# 2. Reemplaza los valores de ejemplo con tus credenciales y secretos locales.
# 3. NUNCA subas el archivo '.env' al repositorio Git (ya está en .gitignore).
# ==============================================================================

# Perfil Activo y Base de Datos (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/app_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tu_password_local_aqui

# Variables para Docker Compose
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=tu_password_postgres_aqui

# Seguridad y Autenticación JWT
# Genera una clave segura de al menos 256 bits (64 caracteres hexadecimales)
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_256_bits_aqui
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_REFRESH_REUSE_GRACE_MS=15000
JWT_COOKIE_SECURE=false

# Integración Facturación Electrónica
# Proveedor: alegra (por defecto), factus (alterno) o mock (desarrollo). Un valor desconocido aborta el arranque.
BILLING_PROVIDER=alegra
# Clave que cifra los secretos de facturación guardados en la base (genérala con `openssl rand -base64 32`).
# NO la pierdas ni la cambies: los secretos guardados dejarían de poder leerse.
BILLING_ENCRYPTION_KEY=genera_una_clave_base64_de_32_bytes_aqui

# --- Alegra (BILLING_PROVIDER=alegra) ---
# Un token de PLATAFORMA por entorno (Bearer). Cada local es una empresa asociada en Alegra: su company.id lo carga el
# SUPER_ADMIN por local y entorno (PUT /api/v1/backoffice/stores/{storeId}/billing/company-id). El token NUNCA va al repo.
ALEGRA_URL_SANDBOX=https://sandbox-api.alegra.com/e-provider/col/v1
ALEGRA_API_TOKEN_SANDBOX=
ALEGRA_URL_PRODUCTION=https://api.alegra.com/e-provider/col/v1
ALEGRA_API_TOKEN_PRODUCTION=

# --- Factus (solo si BILLING_PROVIDER=factus) ---
# Las credenciales de Factus de cada local las carga el super admin desde el sistema y viven cifradas en la base de datos.
# Aquí solo van las URLs públicas (opcionales; estos son los valores por defecto).
FACTUS_URL_SANDBOX=https://api-sandbox.factus.com.co
FACTUS_URL_PRODUCTION=https://api.factus.com.co


# ------------------------------------------------------------------------------
# Cloudflare R2 / Almacenamiento de Imágenes y Archivos
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=tu_cloudflare_account_id_aqui
R2_ACCESS_KEY_ID=tu_r2_access_key_id_aqui
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key_aqui
R2_BUCKET_NAME=app-pos-bucket
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev