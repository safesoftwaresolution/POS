---
import Icon from './Icon.astro';
import Qr from './Qr.astro';
import { links } from '../lib/site.js';

const points = [
  { t: 'La venta no espera.', d: 'Cobras y sigues atendiendo: la factura se emite en segundo plano.' },
  { t: 'Estados claros y reintento en un clic.', d: 'Si algo falla, ves por qué y reenvías sin volver a cobrar.' },
  { t: 'CUFE, código QR, XML firmado y PDF.', d: 'Todo lo que exige la DIAN, listo para ver, descargar o enviar por correo.' },
  { t: 'Tus rangos de numeración, bajo control.', d: 'Prefijo, resolución, vigencia y consecutivo en un solo lugar.' },
  { t: 'Credenciales cifradas y aisladas por local.', d: 'Cada local factura con lo suyo; nadie comparte cupo ni claves.' },
];

const lines = [
  { n: 'Leche 1 L', q: '2', t: '8.400' },
  { n: 'Pan tajado', q: '1', t: '5.800' },
  { n: 'Gaseosa 1,5 L', q: '1', t: '6.500' },
  { n: 'Arroz 500 g', q: '1', t: '3.400' },
];

const steps = ['Venta cobrada', 'En cola', 'Validada'];
---
<section id="facturacion" class="px-3 py-4 sm:px-5 md:py-8">
  <div class="band mx-auto max-w-[1200px] p-6 sm:p-10 md:p-14">
    <div class="pointer-events-none absolute -right-28 -top-28 -z-10 size-[30rem] rounded-full bg-brand/30 blur-[110px]"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-24 -z-10 size-[26rem] rounded-full bg-brand/10 blur-[110px]"></div>

    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">Facturación electrónica DIAN</p>
        <span class="badge badge-warn mt-3">En desarrollo · Muy pronto en la plataforma</span>
        <h2 class="mt-3 text-[clamp(2rem,4.4vw,3.3rem)] leading-[1.04] tracking-[-0.03em]">
          <span class="block font-light">Factura sin</span>
          <span class="block font-extrabold text-brand">frenar la caja<span class="-ml-[0.06em]">.</span></span>
        </h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-white/70 md:text-lg">
          Estamos desarrollando la facturación electrónica y muy pronto estará en la plataforma. Así funcionará: marcas la venta con factura electrónica y PosBento se encarga del resto, a través de un proveedor tecnológico, con el seguimiento de cada documento a la vista.
        </p>

        <ul class="mt-8 space-y-4">
          {points.map((p) => (
            <li class="flex gap-3.5">
              <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-brand text-on-brand"><Icon name="check" class="size-3.5" /></span>
              <p class="text-[15px] leading-relaxed text-white/70"><strong class="font-bold text-white">{p.t}</strong> {p.d}</p>
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-2">
          <span class="mr-1 text-xs font-semibold text-white/50">Estados que tendrás:</span>
          <span class="badge badge-warn">Pendiente</span>
          <span class="badge badge-ok">Validada</span>
          <span class="badge badge-bad">Rechazada</span>
          <span class="badge badge-bad">Error</span>
        </div>

        <a href={links.register} class="btn btn-brand btn-lg mt-9">
          Crear mi cuenta <Icon name="arrow-right" class="size-4" />
        </a>
      </div>

      <!-- Documento de ejemplo -->
      <div class="reveal relative" style="--d:120ms" role="img" aria-label="Ejemplo ilustrativo de una factura electrónica validada, con CUFE y código QR. Función en desarrollo">
        <div class="rotate-1 rounded-3xl bg-white p-6 text-neutral-900 shadow-[0_40px_90px_-30px_rgba(0,0,0,0.7)] sm:p-7" style="--qr-bg:#fff">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-wider text-neutral-500">Factura electrónica de venta</p>
              <p class="mt-1 text-2xl font-extrabold tracking-tight">FE-1042</p>
            </div>
            <span class="badge border-emerald-200 bg-emerald-50 text-emerald-700"><Icon name="circle-check" class="size-3" /> Validada</span>
          </div>

          <div class="mt-5 rounded-2xl bg-neutral-100 px-4 py-3 text-xs">
            <p class="font-bold">María Gómez</p>
            <p class="text-neutral-500 tabular-nums">CC 1.020.•••.•••</p>
          </div>

          <div class="mt-3 divide-y divide-neutral-200 text-xs">
            {lines.map((l) => (
              <div class="flex items-center justify-between py-2.5">
                <span class="font-semibold">{l.n} <span class="font-medium text-neutral-400">× {l.q}</span></span>
                <span class="font-bold tabular-nums">$ {l.t}</span>
              </div>
            ))}
          </div>
          <div class="flex items-end justify-between border-t border-neutral-300 pt-3">
            <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-500">Total (IVA incluido)</span>
            <span class="text-2xl font-extrabold tracking-tight tabular-nums">$ 24.100</span>
          </div>

          <div class="mt-5 flex items-center gap-4 border-t border-dashed border-neutral-300 pt-5">
            <Qr class="size-[4.5rem] shrink-0 text-neutral-900" />
            <div class="min-w-0">
              <p class="text-[10px] font-bold uppercase tracking-wider text-neutral-500">CUFE</p>
              <p class="truncate font-mono text-[11px] text-neutral-700">a3f9c2e1…7b40d8e5</p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <span class="inline-flex items-center gap-1 rounded-full bg-neutral-100 px-2.5 py-1 text-[10px] font-bold text-neutral-700"><Icon name="file-text" class="size-3" /> XML firmado</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-neutral-100 px-2.5 py-1 text-[10px] font-bold text-neutral-700"><Icon name="download" class="size-3" /> PDF</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Recorrido de una factura -->
        <div class="mx-auto -mt-5 flex max-w-sm items-center justify-between gap-1 rounded-2xl border border-white/10 bg-[#17171B]/90 px-4 py-3 text-[11px] font-bold text-white shadow-xl backdrop-blur">
          {steps.map((s, i) => (
            <>
              <span class="flex items-center gap-1.5">
                <span class="grid size-5 place-items-center rounded-full bg-emerald-500/20 text-emerald-400"><Icon name="check" class="size-3" /></span>
                {s}
              </span>
              {i < steps.length - 1 && <span class="h-px flex-1 bg-white/20"></span>}
            </>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
