---
import Icon from './Icon.astro';
import { faq } from '../lib/faq.js';
import { links } from '../lib/site.js';
---
<section id="preguntas" class="pb-20 md:pb-28">
  <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 class="mt-3 text-[clamp(1.9rem,4vw,2.8rem)] leading-[1.06] tracking-[-0.03em]">
        <span class="font-light">Lo que casi todos</span>
        <span class="font-extrabold"> preguntan.</span>
      </h2>
      <p class="mt-5 max-w-sm text-base leading-relaxed text-ink-soft">
        ¿Te quedó otra duda? Escríbenos desde la página de soporte y te ayudamos.
      </p>
      <a href={links.support} class="btn btn-ghost mt-6">Ir a soporte <Icon name="arrow-up-right" class="size-4" /></a>
    </div>

    <div class="faq space-y-3">
      {faq.map((f, i) => (
        <div class="reveal" style={`--d:${i * 50}ms`}>
          <details name="faq" open={i === 0} class="rounded-3xl border border-line bg-card px-6 transition-colors">
            <summary class="flex items-center justify-between gap-4 py-5 text-[15px] font-bold leading-snug">
              {f.q}
              <span class="faq-chevron grid size-8 shrink-0 place-items-center rounded-full bg-page text-ink-soft transition-transform duration-300">
                <Icon name="chevron-down" class="size-4" />
              </span>
            </summary>
            <p class="pb-6 pr-8 text-[15px] leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        </div>
      ))}
    </div>
  </div>
</section>
