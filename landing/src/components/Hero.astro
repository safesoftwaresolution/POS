---
import Icon from './Icon.astro';
import HeroMock from './HeroMock.astro';
import { links } from '../lib/site.js';
---
<section class="relative isolate overflow-hidden pb-20 pt-32 md:pb-28 md:pt-44">
  <div class="hero-glow absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="dot-grid absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="wrap text-center">
    <p class="fade-up inline-flex items-center gap-2.5 rounded-full border border-line bg-card px-4 py-1.5 text-xs font-semibold text-ink-soft" style="--d:0ms">
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand opacity-60"></span>
        <span class="relative inline-flex size-2 rounded-full bg-brand"></span>
      </span>
      <span class="sm:hidden">Punto de venta · Inventario · DIAN</span>
      <span class="hidden sm:inline">Punto de venta · Inventario · Factura electrónica DIAN</span>
    </p>

    <h1 class="fade-up mt-7 text-[clamp(2.75rem,8vw,5.75rem)] leading-[0.98] tracking-[-0.035em]" style="--d:120ms">
      <span class="block font-light">Tu negocio,</span>
      <span class="block font-extrabold text-brand">en equilibrio<span class="-ml-[0.06em]">.</span></span>
    </h1>

    <p class="fade-up mx-auto mt-7 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg" style="--d:240ms">
      PosBento reúne tu caja, tu inventario y tu facturación electrónica DIAN en un solo sistema, claro y rápido, hecho para el comercio colombiano.
    </p>

    <div class="fade-up mt-9 flex flex-wrap items-center justify-center gap-3" style="--d:340ms">
      <a href={links.register} class="btn btn-brand btn-lg">
        Crear cuenta <Icon name="arrow-right" class="size-4" />
      </a>
      <a href={links.login} class="btn btn-ghost btn-lg">Ingresar al sistema</a>
    </div>
    <p class="fade-up mt-5 text-xs font-medium text-ink-muted" style="--d:400ms">
      Funciona en cualquier navegador y se instala en tu celular.
    </p>
  </div>

  <div class="wrap mt-16 md:mt-20">
    <HeroMock />
    <p class="mt-14 text-center text-xs font-medium text-ink-muted">
      Vista de ejemplo con datos ficticios.
      <button
        type="button"
        data-mock-toggle
        aria-pressed="false"
        class="ml-1 rounded-md px-1 font-semibold text-ink-soft underline decoration-line-strong underline-offset-4 transition-colors hover:text-ink"
      >Pausar animación</button>
    </p>
  </div>
</section>
