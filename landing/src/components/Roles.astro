---
import Icon from './Icon.astro';

// Resumen de permisos segun CLAUDE.md (roles) y las rutas protegidas del SPA.
const roles = [
  {
    i: 'AD',
    t: 'Administrador',
    d: 'Control total de su local.',
    items: ['Usuarios, caja y documentos', 'Configuración y habilitación de facturación', 'Todo lo que hacen los demás roles'],
  },
  {
    i: 'SU',
    t: 'Supervisor',
    d: 'Abastecimiento y control.',
    items: ['Compras y proveedores', 'Inventario y clientes', 'Reintento de facturas'],
  },
  {
    i: 'VE',
    t: 'Vendedor',
    d: 'Ventas en el mostrador.',
    items: ['Cobro en caja con lector o cámara', 'Consulta del catálogo'],
  },
];
---
<section class="pb-20 md:pb-28">
  <div class="wrap">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Roles y permisos</p>
      <h2 class="mt-3 text-[clamp(1.9rem,4.2vw,3rem)] leading-[1.06] tracking-[-0.03em]">
        <span class="font-light">Cada persona ve</span>
        <span class="font-extrabold"> lo que necesita.</span>
      </h2>
      <p class="mt-5 text-base leading-relaxed text-ink-soft md:text-lg">
        Tu equipo entra con su propio usuario y solo accede a lo que le corresponde.
      </p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {roles.map((r, i) => (
        <div class="reveal" style={`--d:${i * 100}ms`}>
          <article class="bento-card h-full p-7">
            <div class="flex items-center gap-3.5">
              <span class="grid size-12 place-items-center rounded-full bg-solid text-sm font-extrabold tracking-wide text-solid-ink">{r.i}</span>
              <div>
                <h3 class="text-lg font-extrabold tracking-tight">{r.t}</h3>
                <p class="text-sm text-ink-soft">{r.d}</p>
              </div>
            </div>
            <ul class="mt-6 space-y-3 border-t border-line pt-5">
              {r.items.map((it) => (
                <li class="flex items-start gap-2.5 text-[14px] font-medium leading-snug text-ink-soft">
                  <Icon name="check" class="mt-0.5 size-4 text-brand-text" /> {it}
                </li>
              ))}
            </ul>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
